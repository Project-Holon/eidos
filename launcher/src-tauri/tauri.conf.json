{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eidos launcher",
  "version": "0.1.0",
  "identifier": "org.holon.eidos.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "eidos launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "eidos"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERERjM4MjM2Q0Q1QzQ4MUQKUldRZFNGek5Ob0x6M2FFTUJTcTd6VFpYR2ZxVGtTYksxQ2pxUDUwcDIyYU9TNDVZaEFMRXNzOFcK",
      "endpoints": [
        "https://github.com/Project-Holon/eidos/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "app"
    ],
    "category": "Game",
    "shortDescription": "Profiles, versions and mods for eidos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  }
}
